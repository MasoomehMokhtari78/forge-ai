# Main application database
# When running backend on the host, use localhost:5432:
DATABASE_URL=postgresql+psycopg://forgeai:forgeai@localhost:5432/forgeai
# When running backend in Docker Compose, compose sets postgres:5432 and host.docker.internal:11434 automatically.

# Separate database used by pytest. Create it once:
#   docker compose exec postgres createdb -U forgeai forgeai_test
TEST_DATABASE_URL=postgresql+psycopg://forgeai:forgeai@localhost:5432/forgeai_test

# Local directory where repositories will be cloned
REPOSITORY_STORAGE_PATH=./data/repositories

# Local Embedding Configuration (Sentence Transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=auto


# Chunking Configuration (lines)
CHUNK_SIZE=50
CHUNK_OVERLAP=10

# RAG & Retrieval Configuration
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000

# Agent Configuration
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_CONTEXT_CHARS=12000
AGENT_MAX_FILE_READ_LINES=500

# LLM Provider Configuration
# Set LLM_PROVIDER=ollama for local Ollama, LLM_PROVIDER=gemini for Google Gemini, or mock for testing
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=