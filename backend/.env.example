# Main application database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql+psycopg://forgeai:forgeai@localhost:5432/forgeai

# Separate database used by pytest. Create it once:
#   docker compose exec postgres createdb -U forgeai forgeai_test
TEST_DATABASE_URL=postgresql+psycopg://forgeai:forgeai@localhost:5432/forgeai_test

# Local directory where repositories will be cloned
REPOSITORY_STORAGE_PATH=./data/repositories

# Local Embedding Configuration (Sentence Transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=auto


# Chunking Configuration (lines)
CHUNK_SIZE=50
CHUNK_OVERLAP=10

# RAG & Retrieval Configuration
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000
